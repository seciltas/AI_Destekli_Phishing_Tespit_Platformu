        "url": "http://host.docker.internal:8001/internal/signals/text-urls",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "X-N8N-Secret", "value": "={{ $env.N8N_SHARED_SECRET }}"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { text: $('Validate Request').item.json.text } }}",
