{
  "id": "sprint2TextAnalysis",
  "name": "Sprint 2 - SMS Email Phishing Analysis",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "phishing-text-analysis",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1f26594c-45d5-41b8-bdaf-b586f0e00b60",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-640, 120],
      "webhookId": "a17d0e29-330c-45c3-9307-c88f479ac59e"
    },
    {
      "parameters": {
        "jsCode": "const request = $('Webhook').first().json;\nconst provided = request.headers?.['x-n8n-secret'];\nif (!provided || provided !== $env.N8N_SHARED_SECRET) {\n  throw new Error('Unauthorized webhook request');\n}\nconst text = String(request.body?.text ?? '').trim();\nif (text.length < 3 || text.length > 20000) {\n  throw new Error('Text must contain between 3 and 20000 characters');\n}\nreturn [{ json: { text } }];"
      },
      "id": "49d81243-acde-4ea8-bec5-4810aef819f5",
      "name": "Validate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-400, 120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8001/internal/signals/text-urls",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "X-N8N-Secret", "value": "={{ $env.N8N_SHARED_SECRET }}"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { text: $('Validate Request').item.json.text } }}",
        "options": {"timeout": 120000}
      },
      "id": "6469a554-528a-440b-a742-3b56b86cad7f",
      "name": "VirusTotal URL Checks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-160, 120],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const result = $json ?? {};\nif (Array.isArray(result.urls)) {\n  return [{ json: { urls: result.urls, warning: null } }];\n}\nconst message = result.error?.message ?? result.message ?? 'VirusTotal URL checks unavailable';\nreturn [{ json: { urls: [], warning: `VirusTotal adımı tamamlanamadı: ${message}` } }];"
      },
      "id": "9eae5895-5c9d-4ff0-a326-e73346588293",
      "name": "Normalize URL Checks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [80, 120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8001/internal/text-analysis",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "X-N8N-Secret", "value": "={{ $env.N8N_SHARED_SECRET }}"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { text: $('Validate Request').item.json.text, url_checks: $json.urls } }}",
        "options": {"timeout": 60000}
      },
      "id": "d6671358-26eb-4263-bd96-fae4239f466b",
      "name": "Text Risk and AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [320, 120],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const analysis = $json ?? {};\nconst urlState = $('Normalize URL Checks').first().json;\nconst warnings = urlState.warning ? [urlState.warning] : [];\nif (typeof analysis.risk !== 'number' || !analysis.status || !Array.isArray(analysis.reasons)) {\n  const message = analysis.error?.message ?? analysis.message ?? 'Text analysis service unavailable';\n  return [{ json: { status_code: 502, body: { detail: 'Metin analiz workflow tamamlanamadı.', workflow_stage: 'text_risk_and_ai', workflow_error: message, workflow_warnings: warnings } } }];\n}\nreturn [{ json: { status_code: 200, body: { ...analysis, workflow_warnings: warnings } } }];"
      },
      "id": "4ba9d9f0-d38d-4b94-943a-18ae20f4db9b",
      "name": "Finalize Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [560, 120]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.body }}",
        "options": {"responseCode": "={{ $json.status_code }}"}
      },
      "id": "449fda36-f44c-45e1-a45b-c328b4b4591f",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [800, 120]
    }
  ],
  "pinData": {},
  "connections": {
