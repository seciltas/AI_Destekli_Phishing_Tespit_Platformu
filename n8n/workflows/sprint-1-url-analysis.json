    {
      "parameters": {
        "jsCode": "const request = $('Webhook').first().json.body;\nconst whois = $('WHOIS').first().json;\nconst dns = $('DNS').first().json;\nconst ssl = $('SSL').first().json;\nconst brand = $('Brand Similarity').first().json;\nconst virustotal = $('VirusTotal').first().json;\nreturn [{ json: {\n  url: request.url,\n  domain: request.domain,\n  domain_age_days: whois.domain_age_days ?? null,\n  whois: { ...(whois.whois ?? {}), ssl: ssl.ssl ?? {} },\n  dns: dns.dns ?? {},\n  ssl_valid: ssl.ssl_valid ?? null,\n  brand_similarity: brand.brand_similarity ?? {},\n  virustotal: virustotal.virustotal ?? {}\n} }];"
      },
